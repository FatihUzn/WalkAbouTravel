# ============================================================
#  WalkAbout Travel — .htaccess
#  Yönlendirme · Güvenlik · Performans
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# ─── 1. HATA SAYFASI ────────────────────────────────────────
ErrorDocument 404 /404.html

# ─── 2. HASSAS DOSYALARI KAPAT ──────────────────────────────
# Tur/blog veritabanı, önbellek, hata kaydı ve iç dokümanlar
# tarayıcıdan indirilemesin.
RedirectMatch 404 ^/(data|cache)/
<FilesMatch "(?i)\.(json|log|md|bak|sql|ini|sh|dist|lock)$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(error_log|\.ftpquota|\.htaccess|htaccess|composer\.(json|lock)|config\.php|functions\.php)$">
    Require all denied
</FilesMatch>
# Panelin HTML'i doğrudan açılamaz; sadece admin.php (şifreli) sunar.
<Files "admin.html">
    Require all denied
</Files>

# ─── 3. TEK ALAN ADI + HTTPS ────────────────────────────────
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# www'suz + https'e 301 (Google için tek kanonik adres)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^ https://walkabouttravel.com.tr%{REQUEST_URI} [L,R=301]

# Eski/ham dosya adlarını güzel adreslere yolla
RewriteRule ^index\.php$      / [L,R=301]
RewriteRule ^blog\.php$       /blog/ [L,R=301]
RewriteRule ^old-index\.html$ / [L,R=301]

# ─── 4. YÖNLENDİRME ─────────────────────────────────────────
# Gerçek dosya/klasörlere dokunma
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Blog
RewriteRule ^blog/?$                          blog.php [L,QSA]
RewriteRule ^(en|es|ar|pt)/blog/?$            blog.php [L,QSA]
RewriteRule ^blog/([a-z0-9-]+)/?$             blog-post.php [L,QSA]
RewriteRule ^(en|es|ar|pt)/blog/([a-z0-9-]+)/?$ blog-post.php [L,QSA]

# Dil ana sayfaları  (/en/  /es/  /ar/  /pt/)
RewriteRule ^(en|es|ar|pt)/?$                 index.php [L,QSA]

# Tur detay — yabancı dil
RewriteRule ^(en|es|pt|ar)/([^/]+)/?$         tour.php [L,QSA]

# Tur detay — Türkçe
RewriteCond %{REQUEST_URI} !^/(admin|data|cache|assets|css|js|images|fonts|uploads)/
RewriteCond %{REQUEST_URI} !^/(index|admin|admin-login|save|sitemap|tour|blog|blog-post|contact|404|robots|config|functions)\.
RewriteRule ^([^/]+)/?$                       tour.php [L,QSA]
</IfModule>

# ─── 5. GÜVENLİK BAŞLIKLARI ─────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ─── 6. SIKIŞTIRMA ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript \
        application/javascript application/x-javascript application/json application/xml \
        application/xhtml+xml application/rss+xml image/svg+xml font/ttf font/otf
    <IfModule mod_setenvif.c>
        BrowserMatch ^Mozilla/4 gzip-only-text/html
        BrowserMatch ^Mozilla/4\.0[678] no-gzip
        BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    </IfModule>
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>

# ─── 7. TARAYICI ÖNBELLEĞİ ──────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp     "access plus 1 year"
    ExpiresByType image/jpeg     "access plus 1 year"
    ExpiresByType image/png      "access plus 1 year"
    ExpiresByType image/gif      "access plus 1 year"
    ExpiresByType image/svg+xml  "access plus 1 year"
    ExpiresByType image/x-icon   "access plus 1 year"
    ExpiresByType video/mp4      "access plus 1 year"
    ExpiresByType font/woff2     "access plus 1 year"
    ExpiresByType font/woff      "access plus 1 year"
    ExpiresByType text/css       "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/html      "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(webp|jpe?g|png|gif|svg|ico|woff2?|ttf|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "(?i)\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "(?i)\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    Header unset ETag
</IfModule>
FileETag None

# ============================================================
#  NOT: cPanel'in "# php -- BEGIN cPanel-generated handler"
#  bloğu bilinçli olarak kaldırıldı. Eski blok PHP 7.2'yi
#  işaret ediyordu; site PHP 8 gerektiriyor. Sürümü artık
#  cPanel > MultiPHP Manager belirliyor. cPanel bu bloğu
#  kendisi geri ekleyebilir — sorun değil, yeter ki
#  ea-php80 veya üstünü göstersin.
# ============================================================

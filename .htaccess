# ============================================================
#  .htaccess — WalkAbout Travel URL Yönlendirme
#  Konum: site kök dizini (index.html ile aynı yerde)
# ============================================================

Options -Indexes
RewriteEngine On

# --- data/ klasörünü dışarıdan koru ---
#RewriteRule ^data/ - [F,L]

# --- Sitemap ---
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- Statik dosyalar, PHP ve mevcut klasörler dokunma ---
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- Blog listesi: /blog/ ve /en/blog/ ---
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^(en|es|ar|pt)/blog/?$ blog.php [L,QSA]

# --- Blog yazı detay: /blog/{slug}/ ve /en/blog/{slug}/ ---
RewriteRule ^blog/([a-z0-9-]+)/?$ blog-post.php [L,QSA]
RewriteRule ^(en|es|ar|pt)/blog/([a-z0-9-]+)/?$ blog-post.php [L,QSA]

# --- Dil prefix'li tur URL'leri: /en/cappadocia-balloon-tour/ ---
# [a-z0-9-]+ yerine daha geniş karakter seti (uzun sluglar için)
RewriteRule ^(en|es|ar|pt)/([a-z0-9][a-z0-9-]*)/?$ tour.php [L,QSA]

# --- Türkçe tur URL'leri: /kapadokya-balon-turu/ ---
RewriteCond %{REQUEST_URI} !^/(admin|data|assets|css|js|images|fonts|uploads)/
RewriteCond %{REQUEST_URI} !^/(index|admin|save|sitemap|tour|blog|404|robots)\.
RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ tour.php [L,QSA]

# --- Performans: statik dosya cache ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg   "access plus 1 year"
    ExpiresByType image/png    "access plus 1 year"
    ExpiresByType image/webp   "access plus 1 year"
    ExpiresByType image/gif    "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css     "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType font/woff2   "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|webp|png|gif|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# --- Gzip sıkıştırma ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Gerçekte var olan dosya ve klasörleri (CSS, JS, resimler vb.) engelleme
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. İngilizce, İspanyolca vb. dil ön eki olan tur linklerini (Örn: /en/tur-adi/) tour.php'ye yönlendir
RewriteRule ^(en|es|pt|ar)/([^/]+)/?$ tour.php [L,QSA]

# 3. Türkçe (ön eksiz) tur linklerini (Örn: /tur-adi/) tour.php'ye yönlendir
RewriteRule ^([^/]+)/?$ tour.php [L,QSA]
</IfModule>
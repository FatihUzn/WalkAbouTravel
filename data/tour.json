// Tours.js - WalkAbout Travel Tour Display Component
// galleries.json ile entegre çalışır

class TourManager {
    constructor() {
        this.tours = [];
        this.galleries = {};
        this.currentLang = localStorage.getItem('language') || 'tr';
        this.filteredCategory = 'all';
        this.init();
    }

    async init() {
        await this.loadGalleries();
        this.convertGalleriesToTours();
        this.setupEventListeners();
        this.displayTours();
    }

    async loadGalleries() {
        try {
            // Önce galleries.json'ı dene (mevcut sistem)
            let response = await fetch('data/galleries.json');
            if (response.ok) {
                this.galleries = await response.json();
                console.log(`✅ ${Object.keys(this.galleries).length} galeri yüklendi (galleries.json)`);
                return;
            }
            
            // Yoksa tours.json'ı dene (yeni sistem)
            response = await fetch('data/tours.json');
            if (response.ok) {
                this.tours = await response.json();
                console.log(`✅ ${this.tours.length} tur yüklendi (tours.json)`);
                return;
            }
            
            throw new Error('Ne galleries.json ne de tours.json bulunamadı');
        } catch (error) {
            console.error('❌ Turlar yüklenemedi:', error);
            this.tours = this.getSampleTours();
        }
    }

    convertGalleriesToTours() {
        // Eğer galleries varsa, onları tour formatına çevir
        if (Object.keys(this.galleries).length > 0) {
            this.tours = [];
            for (const [id, gallery] of Object.entries(this.galleries)) {
                this.tours.push({
                    id: id,
                    title: gallery.title,
                    title_en: gallery.title, // İngilizce yoksa aynısını kullan
                    price: gallery.price,
                    duration: gallery.price.split(',')[0] || 'N/A', // "5 Gün / 4 Gece" kısmı
                    location: gallery.location,
                    area: gallery.area,
                    category: this.getCategoryFromId(id),
                    description: gallery.desc,
                    description_en: gallery.desc,
                    image: gallery.images && gallery.images[0] ? gallery.images[0] : 'assets/placeholder.jpg',
                    images: gallery.images || [],
                    content: gallery.desc,
                    content_en: gallery.desc
                });
            }
            console.log(`✅ ${this.tours.length} galeri tura dönüştürüldü`);
        }
    }

    getCategoryFromId(id) {
        if (id.includes('TR')) return 'Türkiye';
        if (id.includes('D-ISPANYA')) return 'Avrupa';
        if (id.includes('D-RUSYA')) return 'Avrupa';
        if (id.includes('D-BREZILYA')) return 'Amerika';
        if (id.includes('D-AMERIKA')) return 'Amerika';
        return 'Genel';
    }

    setupEventListeners() {
        // Kategori filtreleri
        document.querySelectorAll('.tour-category-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const category = e.target.dataset.category;
                this.filterByCategory(category);
            });
        });

        // Dil değişimi
        document.addEventListener('languageChanged', (e) => {
            this.currentLang = e.detail.lang;
            this.displayTours();
        });
    }

    filterByCategory(category) {
        this.filteredCategory = category;
        
        // Aktif butonu güncelle
        document.querySelectorAll('.tour-category-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        const activeBtn = document.querySelector(`[data-category="${category}"]`);
        if (activeBtn) {
            activeBtn.classList.add('active');
        }
        
        this.displayTours();
    }

    displayTours() {
        const container = document.querySelector('.tours-grid');
        if (!container) return;

        // Filtreleme
        let filtered = this.tours;
        if (this.filteredCategory !== 'all') {
            filtered = this.tours.filter(tour => tour.category === this.filteredCategory);
        }

        // Temizle
        container.innerHTML = '';

        if (filtered.length === 0) {
            container.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #64748b; padding: 40px;">Henüz tur bulunmuyor.</p>';
            return;
        }

        // Turları göster
        filtered.forEach(tour => {
            const card = this.createTourCard(tour);
            container.appendChild(card);
        });

        // Sayı güncelle
        const countElement = document.querySelector('.tour-count');
        if (countElement) {
            countElement.textContent = filtered.length;
        }
    }

    createTourCard(tour) {
        const card = document.createElement('div');
        card.className = 'tour-card';
        card.dataset.category = tour.category;

        const title = tour.title || 'Tur Başlığı';
        const description = tour.description || tour.desc || '';

        card.innerHTML = `
            <div class="tour-image">
                <img src="${tour.image}" alt="${title}" loading="lazy" 
                     onerror="this.src='https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=600'">
                <div class="tour-badge">${tour.category || 'Tur'}</div>
            </div>
            <div class="tour-content">
                <h3>${title}</h3>
                <p>${description.substring(0, 120)}...</p>
                <div class="tour-features">
                    ${tour.price ? `<span class="feature-tag"><i class="fas fa-tag"></i> ${tour.price}</span>` : ''}
                    ${tour.duration ? `<span class="feature-tag"><i class="fas fa-clock"></i> ${tour.duration}</span>` : ''}
                    ${tour.location ? `<span class="feature-tag"><i class="fas fa-map-marker-alt"></i> ${tour.location}</span>` : ''}
                </div>
                <a href="tour-detail.html?id=${tour.id}" class="tour-link">
                    <span>${this.currentLang === 'tr' ? 'Detayları Gör' : 'View Details'}</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        `;

        return card;
    }

    getSampleTours() {
        return [
            {
                id: 'SAMPLE-1',
                title: 'Örnek Tur - Kapadokya',
                title_en: 'Sample Tour - Cappadocia',
                price: '9.800 TL',
                duration: '4 Gün / 3 Gece',
                location: 'Göreme',
                area: 'İç Anadolu',
                category: 'Kültür',
                description: 'Kapadokya\'nın büyülü atmosferinde sıcak hava balonu deneyimi.',
                description_en: 'Hot air balloon experience in Cappadocia\'s magical atmosphere.',
                image: 'assets/kapadokya-balon-turu-1.webp',
                content: 'Detaylı içerik...',
                content_en: 'Detailed content...'
            }
        ];
    }
}

// Initialize
let tourManager;
document.addEventListener('DOMContentLoaded', () => {
    tourManager = new TourManager();
});
